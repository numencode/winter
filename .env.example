APP_NAME="Winter CMS"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file

SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_LOG_CHANNEL=null
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

ROUTES_CACHE=false
ASSET_CACHE=false
LINK_POLICY=detect
ENABLE_CSRF=true
DATABASE_TEMPLATES=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Dropbox (NumenCode.DropboxAdapter) – set by: php artisan dropboxadapter:setup
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=
# Optional folder for all files of this site
DROPBOX_ROOT=
# SyncOps – connection "production" (see config/syncops.php and the plugin README)
# SSH login: a private key (recommended) or a password
SYNCOPS_PRODUCTION_HOST=
SYNCOPS_PRODUCTION_USERNAME=
SYNCOPS_PRODUCTION_KEY=
# The server's host key; shown by: php artisan syncops:validate --connect
SYNCOPS_PRODUCTION_HOST_FINGERPRINT=
# PHP and Composer on the server, e.g. php8.4 and "php8.4 /usr/bin/composer" if its default PHP is another version
SYNCOPS_PRODUCTION_PHP=
SYNCOPS_PRODUCTION_COMPOSER=
# The project on the server
SYNCOPS_PRODUCTION_PATH=
SYNCOPS_PRODUCTION_BRANCH_PROD=prod
SYNCOPS_PRODUCTION_BRANCH_MAIN=main
# The server's database (db-pull, remote-health)
SYNCOPS_PRODUCTION_DB_DATABASE=
SYNCOPS_PRODUCTION_DB_USERNAME=
SYNCOPS_PRODUCTION_DB_PASSWORD=
# Local database clients, if they are not in the PATH
SYNCOPS_MYSQL=
SYNCOPS_MYSQLDUMP=